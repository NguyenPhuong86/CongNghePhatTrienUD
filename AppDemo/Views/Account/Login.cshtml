@model LoginViewModel

@{
    ViewData["Title"] = "Đăng nhập";
}

<section class="page-surface auth-panel">
    <div class="page-heading">
        <div>
            <p class="eyebrow">Identity</p>
            <h1>Đăng nhập</h1>
            <p class="text-muted mb-0">Tài khoản Admin dùng để xem các thao tác thêm, sửa và xóa dữ liệu trong màn hình CRUD.</p>
        </div>
    </div>

    <form asp-action="Login" method="post" class="demo-form">
        <input type="hidden" asp-for="ReturnUrl" />
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <div class="mb-3">
            <label asp-for="Email" class="form-label">Email</label>
            <input asp-for="Email" class="form-control" autocomplete="username" />
            <span asp-validation-for="Email" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Password" class="form-label">Mật khẩu</label>
            <input asp-for="Password" class="form-control" autocomplete="current-password" />
            <span asp-validation-for="Password" class="text-danger"></span>
        </div>

        <div class="form-check mb-3">
            <input asp-for="RememberMe" class="form-check-input" />
            <label asp-for="RememberMe" class="form-check-label">Ghi nhớ đăng nhập</label>
        </div>

        <button type="submit" class="btn btn-primary">Đăng nhập</button>
        <a class="btn btn-secondary" asp-action="Register">Đăng ký</a>

        <p class="mt-3">
            Tài khoản quản trị demo:
            <strong>admin@appdemo.local</strong> /
            <strong>Admin@@123456!</strong>
        </p>
    </form>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
