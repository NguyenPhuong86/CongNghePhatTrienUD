@model RegisterViewModel

@{
    ViewData["Title"] = "Đăng ký";
}

<section class="page-surface auth-panel">
    <div class="page-heading">
        <div>
            <p class="eyebrow">Identity</p>
            <h1>Đăng ký</h1>
            <p class="text-muted mb-0">Tài khoản mới được gán role người dùng thường sau khi tạo thành công.</p>
        </div>
    </div>

    <form asp-action="Register" method="post" class="demo-form">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <div class="mb-3">
            <label asp-for="Email" class="form-label">Email</label>
            <input asp-for="Email" class="form-control" autocomplete="username" />
            <span asp-validation-for="Email" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Password" class="form-label">Mật khẩu</label>
            <input asp-for="Password" class="form-control" autocomplete="new-password" />
            <span asp-validation-for="Password" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="ConfirmPassword" class="form-label">Xác nhận mật khẩu</label>
            <input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" />
            <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
        </div>

        <button type="submit" class="btn btn-primary">Đăng ký</button>
        <a class="btn btn-secondary" asp-action="Login">Đăng nhập</a>
    </form>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
