@model ErrorViewModel
@{
    ViewData["Title"] = "Lỗi";
}

<section class="page-surface">
    <h1 class="text-danger">Đã xảy ra lỗi.</h1>
    <p class="text-muted">Ứng dụng không xử lý được request hiện tại.</p>

    @if (Model.ShowRequestId)
    {
        <p>
            <strong>Mã request:</strong> <code>@Model.RequestId</code>
        </p>
    }

    <h2>Chế độ phát triển</h2>
    <p>
        Khi chạy môi trường <strong>Development</strong>, ASP.NET Core có thể hiển thị thông tin lỗi chi tiết hơn để phục vụ gỡ lỗi cục bộ.
    </p>
</section>
