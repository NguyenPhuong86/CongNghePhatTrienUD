@model Speaker

@{
    ViewData["Title"] = "Thêm diễn giả";
}

<section class="page-surface">
    <div class="page-heading">
        <div>
            <p class="eyebrow">CRUD</p>
            <h1>Thêm diễn giả</h1>
            <p class="text-muted mb-0">Form minh họa model binding, validation và luồng POST trong MVC.</p>
        </div>
    </div>

    <form asp-action="Create" method="post" class="demo-form">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <div class="mb-3">
            <label asp-for="Name" class="form-label">Tên diễn giả</label>
            <input asp-for="Name" class="form-control" />
            <span asp-validation-for="Name" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Title" class="form-label">Chức danh</label>
            <input asp-for="Title" class="form-control" />
            <span asp-validation-for="Title" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Bio" class="form-label">Tiểu sử</label>
            <textarea asp-for="Bio" class="form-control" rows="4"></textarea>
            <span asp-validation-for="Bio" class="text-danger"></span>
        </div>

        <button type="submit" class="btn btn-primary">Lưu</button>
        <a class="btn btn-secondary" asp-action="Index">Quay lại</a>
    </form>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
